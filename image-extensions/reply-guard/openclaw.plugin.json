{
  "id": "reply-guard",
  "name": "Reply Guard",
  "description": "Configurable outbound reply cancellation with routing-context diagnostics.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "debug": {
        "type": "boolean",
        "default": false,
        "description": "Log routing context and rule decisions at info level, excluding message contents and credentials."
      },
      "rules": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "match"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "match": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "context": {
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": {
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      },
                      {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": [
                            "string",
                            "number",
                            "boolean",
                            "null"
                          ]
                        }
                      }
                    ]
                  }
                },
                "event": {
                  "type": "object",
                  "additionalProperties": false,
                  "minProperties": 1,
                  "properties": {
                    "kind": {
                      "anyOf": [
                        {
                          "enum": [
                            "tool",
                            "block",
                            "final"
                          ]
                        },
                        {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "enum": [
                              "tool",
                              "block",
                              "final"
                            ]
                          }
                        }
                      ]
                    }
                  }
                },
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "minProperties": 1,
                  "properties": {
                    "isError": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "boolean"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
