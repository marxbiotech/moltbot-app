{
  "id": "remote-acpx",
  "name": "Remote ACPX",
  "description": "ACP runtime backend for acpx on a paired node. Requires the v2026.9.5 fork with the public acp-backend SDK.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "target": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["nodeId"],
        "additionalProperties": false
      },
      "targets": {
        "default": {},
        "type": "object",
        "propertyNames": {
          "type": "string",
          "minLength": 1
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "nodeId": {
              "type": "string",
              "minLength": 1
            },
            "cwd": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["nodeId"],
          "additionalProperties": false
        }
      },
      "node": {
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "stateDir": {
            "type": "string",
            "minLength": 1
          },
          "agents": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "permissionMode": {
            "default": "approve-reads",
            "type": "string",
            "enum": ["approve-all", "approve-reads", "deny-all"]
          }
        },
        "required": ["cwd", "stateDir"],
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
