{
  "id": "remote-acpx",
  "name": "Remote ACPX",
  "description": "ACP runtime backend for acpx on a paired node. Requires the v2026.9.5 fork with the public acp-backend SDK.",
  "activation": {
    "onStartup": true
  },
  "skills": ["./skills"],
  "configSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "executionApproval": {
        "type": "string",
        "enum": ["always", "node-policy"],
        "default": "always",
        "description": "Use node-policy only for operator-authorized targets whose node-local exec policy permits full execution without prompting. Otherwise request approval for each operation."
      },
      "target": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["nodeId"],
        "additionalProperties": false
      },
      "targets": {
        "default": {},
        "type": "object",
        "propertyNames": {
          "type": "string",
          "minLength": 1
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "nodeId": {
              "type": "string",
              "minLength": 1
            },
            "cwd": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["nodeId"],
          "additionalProperties": false
        }
      },
      "node": {
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "stateDir": {
            "type": "string",
            "minLength": 1
          },
          "agents": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "permissionMode": {
            "default": "approve-reads",
            "type": "string",
            "enum": ["approve-all", "approve-reads", "deny-all"]
          },
          "nativeModes": {
            "type": "object",
            "propertyNames": { "type": "string", "minLength": 1 },
            "additionalProperties": { "type": "string", "minLength": 1 },
            "description": "Pin each OpenClaw owner agent to an advertised native mode (for example claude: auto, codex: agent). Verified via ACP mode config; unsupported modes fail closed. Use deny-all fallback with native permission callbacks."
          }
        },
        "required": ["cwd", "stateDir"],
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
