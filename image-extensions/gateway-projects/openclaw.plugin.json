{
  "id": "gateway-projects",
  "name": "Gateway Projects",
  "description": "Agent-only tools backed by the gateway project CLI, available in explicitly assigned project conversations.",
  "contracts": {
    "tools": [
      "gateway_project_prepare",
      "gateway_project_github"
    ]
  },
  "toolMetadata": {
    "gateway_project_prepare": {
      "optional": true
    },
    "gateway_project_github": {
      "optional": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projects": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "workspace",
            "authorName",
            "authorEmail",
            "slackAccountId",
            "slackChannelIds"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "workspace": {
              "type": "string",
              "pattern": "^/"
            },
            "authorName": {
              "type": "string",
              "minLength": 1
            },
            "authorEmail": {
              "type": "string",
              "minLength": 1
            },
            "baseBranch": {
              "type": "string",
              "minLength": 1
            },
            "slackAccountId": {
              "type": "string",
              "minLength": 1
            },
            "slackChannelIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[CG][A-Z0-9]+$"
              }
            }
          }
        }
      }
    }
  },
  "skills": [
    "./skills"
  ]
}
